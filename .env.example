# --- Acesso ao sistema (OBRIGATÓRIO em produção: o sistema movimenta a conta do Banco Inter) ---
PASSWORD="troque-esta-senha"
JWT_SECRET="gere-um-valor-aleatorio-longo"

# URL pública (https) onde o sistema está publicado. Usada para cadastrar os webhooks no Inter.
APP_URL="https://cobranca.seudominio.com.br"

# GEMINI_API_KEY: Required for Gemini AI API calls (AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- NFS-e Nacional ---
# O certificado A1 (e-CNPJ) é importado pela tela Configurações (.pfx + senha).
# Alternativa por variável de ambiente (PEM com \n):
# CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Opcional: URL alternativa da Sefin (testes) e AC extra para o TLS
# NFSE_URL_SEFIN=
# NFSE_CA_PATH=

# --- Banco Inter (OAuth2 + mTLS) ---
# Preferencialmente configure em Banco Inter › Configuração (credenciais e upload do .crt/.key).
# Alternativa por variáveis de ambiente:
# INTER_CLIENT_ID=""
# INTER_CLIENT_SECRET=""
# INTER_CONTA_CORRENTE=""
# INTER_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# INTER_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ou caminhos para os arquivos:
# INTER_CERT_PEM_PATH="/run/secrets/inter.crt"
# INTER_KEY_PEM_PATH="/run/secrets/inter.key"

# --- PDF (DANFSe) ---
# Chrome/Chromium usado para gerar o PDF. No Docker já é /usr/bin/chromium.
# PUPPETEER_EXECUTABLE_PATH=

# --- Configurações de E-mail ---
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=contato@virgulacontabil.com.br
MAIL_PASSWORD=
MAIL_FROM_NAME="Financeiro | Vírgula Contábil"
MAIL_FROM_ADDRESS=financeiro@virgulacontabil.com.br
